def factorial(n):
    if n==1:
        return 1
    else:
        return n*factorial(n-1)
print(factorial(3))


#decorator
def logtime(func):
    def wrapper():
        print("Before")
        val = func()
        print("After")
        return val
    return wrapper

@logtime
def hello():
    print("Hello")

hello()

